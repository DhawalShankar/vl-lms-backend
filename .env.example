# Application
PROJECT_NAME="VartaLang LMS API"
ENVIRONMENT=development
PORT=8000
DEBUG=True

# CORS (JSON Array format)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "https://learn.vartalang.in"]

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vartalang_lms

# Security & JWT
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VartaLang Main SSO Integration
VARTALANG_MAIN_AUTH_URL=https://api.vartalang.in/api/v1/sso/verify
SSO_SHARED_SECRET=your_sso_shared_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
